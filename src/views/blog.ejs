<!-- Testing script for likes and unlikes to be removed when API is available  -->

<script>
    document.addEventListener("DOMContentLoaded", function () {
    let likeBtn = document.getElementById("like-btn");
    let likesCount = document.getElementById("likes_count");
    let commentInput = document.getElementById("comment-input");
    let submitCommentBtn = document.getElementById("submit-comment");
    let commentsList = document.getElementById("comments-list");

    let liked = false;
    let likeCount = 0;

    // Handle Like Button Click
    likeBtn.addEventListener("click", function () {
        liked = !liked;
        likeCount += liked ? 1 : -1;
        likesCount.textContent = likeCount;

        let heartIcon = likeBtn.querySelector("i");
        heartIcon.classList.toggle("fa-solid");  
        heartIcon.classList.toggle("fa-regular"); 
    });

    // Handle Comment Submission
    submitCommentBtn.addEventListener("click", function () {
        let commentText = commentInput.value.trim();
        if (commentText === "") return;
        let loggedInUser = 'Elisha';
        let loggedInUser2 = 'Sirsea';

        let comment = document.createElement("li");
        comment.className = "comment-item";
        comment.innerHTML = `
            <div class="comment-header">
               <div class="d-flex align-items-center">
                    <div class="avatar avatar-online">
                        <img src="/images/img23.jpg" class="comment-avatar rounded-circle" alt="User">
                    </div>
                    <div class="me-2 comment-user-details">
                        <div class="comment-username">${loggedInUser} </div>
                        <span class="tx-12comment-date tx-color-03">${new Date().toLocaleString()}</span>
                    </div>
               </div>
                
            </div>
            <p class="comment-text">${commentText}</p>
            <div class="comment-actions">
                <a href="javascript:void(0);" class="like-comment">Like</a>
                <a href="javascript:void(0);" class="reply-comment">Reply</a>
            </div>
            <ul class="replies-list"></ul>
        `;

        commentsList.appendChild(comment);
        commentInput.value = "";

      
        setupCommentEvents(comment);
    });

    function setupCommentEvents(comment) {
        let likeCommentBtn = comment.querySelector(".like-comment");
        let replyCommentBtn = comment.querySelector(".reply-comment");
        let repliesList = comment.querySelector(".replies-list");

        // Like Comment
        likeCommentBtn.addEventListener("click", function () {
            let liked = likeCommentBtn.classList.toggle("liked");
            likeCommentBtn.textContent = liked ? "Unlike" : "Like";
        });

        // Reply to Comment
        replyCommentBtn.addEventListener("click", function () {
            let replyInput = document.createElement("input");
            replyInput.type = "text";
            replyInput.placeholder = "Reply...";
            
            let sendReplyBtn = document.createElement("button");
            sendReplyBtn.textContent = "Reply";
            
            replyCommentBtn.parentNode.appendChild(replyInput);
            replyCommentBtn.parentNode.appendChild(sendReplyBtn);

            sendReplyBtn.addEventListener("click", function () {
                let replyText = replyInput.value.trim();
                if (replyText === "") return;

                let reply = document.createElement("li");
                reply.className = "reply-item";
                reply.innerHTML = `
                    <div class="reply-header">
                        <div class="avatar avatar-online">
                         <img src="/images/img23.jpg" class="reply-avatar rounded-circle" alt="user">
                        </div>
                        <span class="reply-date">${new Date().toLocaleString()}</span>
                    </div>
                    <p class="reply-text">${replyText}</p>
                `;

                repliesList.appendChild(reply);
                replyInput.remove();
                sendReplyBtn.remove();
            });
        });
    }
});

</script>